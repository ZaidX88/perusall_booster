{
  "manifest_version": 3,
  "name": "Dynamic Query Modifier",
  "version": "2.0",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webRequest"
  ],
  "host_permissions": ["https://*.perusall.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configure Parameters"
  },
  "content_scripts": [
    {
      "matches": ["https://*.perusall.com/*"],
      "js": ["content.js"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dynamic_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}